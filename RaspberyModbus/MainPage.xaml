<Page
    x:Class="RaspberryModbus.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>
    </Page.Resources>

    <Grid Background="#202020" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Показания -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Состояние"/>
                <TextBlock x:Name="TbState" FontSize="34" Text="—"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Частота, Гц"/>
                <TextBlock x:Name="TbFreq" FontSize="34" Text="—"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Ток, А"/>
                <TextBlock x:Name="TbCurrent" FontSize="34" Text="—"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="Звено DC, В"/>
                <TextBlock x:Name="TbDc" FontSize="34" Text="—"/>
            </StackPanel>
        </Grid>

        <!-- Авария -->
        <Border Grid.Row="1" x:Name="FaultBar" Background="#3A3A3A" Margin="0,8" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TbFault" Text="Нет связи" Foreground="White"/>
                <Button x:Name="BtnReset" Content="Сброс аварии" Click="OnReset" MinHeight="48"/>
            </StackPanel>
        </Border>

        <!-- Пуск / стоп -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="ПУСК ▶" Click="OnForward" Background="#1B6E2E"/>
            <Button Content="◀ РЕВЕРС" Click="OnReverse" Background="#1F4E8C"/>
            <Button Content="СТОП" Click="OnStop" Background="#A02020" MinWidth="200"/>
            <Button Content="Выбег" Click="OnCoast"/>
        </StackPanel>

        <!-- Частота и торможение -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Частота, Гц:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtFreq" Text="20" InputScope="Number"/>
                <Button Content="Задать" Click="OnSetFreq"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Торможение, с:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtDecelNormal" Text="5.0" InputScope="Number"/>
                <Button Content="Обычное" Click="OnDecelNormal"/>
                <TextBox x:Name="TxtDecelThread" Text="0.5" InputScope="Number"/>
                <Button Content="Резьба" Click="OnDecelThread"/>
            </StackPanel>
            <TextBlock x:Name="TbDecelActive" Text="Активное время торможения: —"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="TbLog" Foreground="Orange" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
    </Grid>
</Page>
